#!/usr/bin/env bash
# op-cached - memoize `op read` values in a macOS keychain.
#
# Measured on op 2.39.0 (`op --debug read`): every invocation makes 3 network
# requests totalling ~720ms -- GET /api/v2/overview, GET /api/v3/account and
# POST /api/v3/user/itemusage -- while the secret itself is served from op's
# own local cache in 1-2ms. That per-invocation overhead is what this avoids;
# keychain reads are ~15ms.
#
# Prefer `op inject` / `op run` when a script needs several secrets at once:
# one invocation pays the ~0.9s once regardless of how many refs it resolves.
#
#   op-cached read op://Vault/Item/field [--ttl SECONDS] [--refresh]
#   op-cached purge
#
# TTL defaults to 12h; override with --ttl or OP_CACHE_TTL.
#
# SECURITY: cached values are encrypted at rest, but the keychain ACL trusts
# /usr/bin/security -- so any process running as you can read them back while
# the keychain is unlocked, without a prompt. Set OP_CACHE_CONFIRM=1 to create
# entries with `-T ""` instead, which forces an approval dialog per access.

set -euo pipefail

SERVICE_PREFIX="op-cached"
INDEX="${XDG_CACHE_HOME:-$HOME/.cache}/op-cached/index"   # hashes only, no secrets
KEYCHAIN="${OP_CACHE_KEYCHAIN:-$HOME/Library/Keychains/login.keychain-db}"
TTL_RAW="${OP_CACHE_TTL:-43200}"
REFRESH=0

die() { printf 'op-cached: %s\n' "$*" >&2; exit 1; }
warn() { printf 'op-cached: %s\n' "$*" >&2; }

# Reject anything that is not a plain decimal integer, then force base 10 so a
# value like "08" is not read as invalid octal. Unvalidated input must never
# reach an arithmetic context: bash re-evaluates names and array subscripts
# there, which turns `--ttl 'x[$(cmd)]'` into command execution.
validate_int() {
  [[ "$1" =~ ^[0-9]{1,10}$ ]] || die "$2 must be a non-negative integer, got: $1"
  printf '%s' "$((10#$1))"
}

# macOS ships `shasum`; Nix's coreutils ships `sha256sum`. The wrapper keeps
# the script working under both without assuming a PATH layout.
sha256_hex() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256
  else sha256sum
  fi
}

kc_get() { security find-generic-password -a "$USER" -s "$1" -w "$KEYCHAIN" 2>/dev/null; }

kc_put() {
  local key="$1" payload="$2" args=(-a "$USER" -s "$key" -U)
  [[ "${OP_CACHE_CONFIRM:-0}" == "1" ]] && args+=(-T "")
  # -w is passed last with no operand so the payload arrives on stdin instead
  # of argv, where `ps` and execution monitors could scrape it.
  printf '%s' "$payload" | security add-generic-password "${args[@]}" "$KEYCHAIN" -w 2>/dev/null
}

cmd_read() {
  local ref="" ttl_opt=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ttl)     [[ $# -ge 2 ]] || die "--ttl requires a value"; ttl_opt="$2"; shift 2 ;;
      --refresh) REFRESH=1; shift ;;
      --)        shift; [[ $# -eq 1 ]] || die "expected exactly one reference"; ref="$1"; shift ;;
      -*)        die "unknown option: $1" ;;
      *)         [[ -z "$ref" ]] || die "expected exactly one reference, got a second: $1"
                 ref="$1"; shift ;;
    esac
  done
  [[ -n "$ref" ]] || die "usage: op-cached read op://Vault/Item/field"
  [[ "$ref" == op://* ]] || die "not a secret reference: $ref"
  # A one-time password is regenerated every 30s; caching one hands back a
  # code that is already dead.
  [[ "$ref" != *attribute=otp* ]] || die "refusing to cache a one-time password: $ref"

  local ttl; ttl="$(validate_int "${ttl_opt:-$TTL_RAW}" "ttl")"

  # The account is part of the cache identity: the same op:// reference can
  # resolve to different secrets under different accounts.
  local key hash
  hash="$(printf '%s\n%s' "${OP_ACCOUNT:-}" "$ref" | sha256_hex | cut -c1-32)"
  key="${SERVICE_PREFIX}:${hash}"

  if [[ "$REFRESH" -eq 0 ]]; then
    local entry ts b64 cached now age
    if entry="$(kc_get "$key")" && [[ "$entry" =~ ^([0-9]{1,19}):(.*)$ ]]; then
      ts="${BASH_REMATCH[1]}"; b64="${BASH_REMATCH[2]}"
      now="$(date +%s)"; age=$(( now - 10#$ts ))
      # age must be non-negative: a timestamp in the future (clock skew, a
      # tampered entry) would otherwise satisfy any TTL, including 0.
      # Check the alphabet first: `base64 -d` happily decodes the valid prefix
      # of a corrupt payload and still exits 0, which would hand back a
      # truncated secret. Note `&& printf x`, not `; printf x` -- the latter
      # would mask a decode failure behind printf's exit status.
      if [[ -n "$b64" ]] && [[ "$b64" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] \
         && (( age >= 0 )) && (( age < ttl )); then
        # Decode fully before emitting anything, so a truncated or corrupt
        # record cannot dribble partial bytes to stdout and then fail.
        if cached="$(printf '%s' "$b64" | base64 -d 2>/dev/null && printf x)"; then
          printf '%s' "${cached%x}"
          return 0
        fi
      fi
    fi
  fi

  # `&& printf x` keeps the trailing newline AND propagates failure: a bare
  # `$(op read "$ref"; printf x)` takes printf's exit status, so a partial
  # write from a failing `op` would be cached and returned as a success.
  local value
  if value="$(op read "$ref" && printf x)"; then
    value="${value%x}"
  else
    die "op read failed for $ref"
  fi
  [[ -n "$value" ]] || die "empty value for $ref"

  # Emit before caching: bookkeeping problems must never lose a secret that
  # was fetched successfully.
  printf '%s' "$value"

  local stamp payload
  if ! stamp="$(date +%s)" || ! payload="$(printf '%s' "$value" | base64)"; then
    warn "could not encode cache entry; not cached"; return 0
  fi
  if kc_put "$key" "${stamp}:${payload}"; then
    if ! { mkdir -p "$(dirname "$INDEX")" \
           && { grep -qxF "$key" "$INDEX" 2>/dev/null || printf '%s\n' "$key" >> "$INDEX"; }; }; then
      warn "cached, but could not record $key in the index (purge may miss it)"
    fi
  else
    warn "could not write cache entry"
  fi
  return 0
}

cmd_purge() {
  [[ $# -eq 0 ]] || die "purge takes no arguments"
  local n=0 failed=0 key kept
  [[ -f "$INDEX" ]] || { printf 'op-cached: nothing cached\n'; return 0; }
  kept="$(mktemp)"
  # `|| [[ -n "$key" ]]` also processes a final line with no trailing newline.
  while IFS= read -r key || [[ -n "$key" ]]; do
    [[ -n "$key" ]] || continue
    # Only ever delete our own namespace: a stray line must not be able to
    # make this remove an unrelated keychain item.
    if [[ ! "$key" =~ ^${SERVICE_PREFIX}:[a-f0-9]{32}$ ]]; then
      warn "skipping unrecognised index entry: $key"; printf '%s\n' "$key" >> "$kept"; continue
    fi
    if security delete-generic-password -a "$USER" -s "$key" "$KEYCHAIN" >/dev/null 2>&1; then
      n=$((n+1))
    else
      # Keep it: dropping the record would strand the secret in the keychain
      # with nothing left pointing at it.
      failed=$((failed+1)); printf '%s\n' "$key" >> "$kept"
    fi
  done < "$INDEX"
  if [[ -s "$kept" ]]; then mv "$kept" "$INDEX"; else rm -f "$kept" "$INDEX"; fi
  printf 'op-cached: purged %d entries' "$n"
  [[ "$failed" -eq 0 ]] && printf '\n' || printf ', %d retained (delete failed)\n' "$failed"
}

case "${1:-}" in
  read)  shift; cmd_read "$@" ;;
  purge) shift; cmd_purge "$@" ;;
  *)     die "usage: op-cached {read <ref> [--ttl N] [--refresh] | purge}" ;;
esac
